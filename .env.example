# Copy this file to .env and fill in values. .env is gitignored.
# All values below are placeholders - never commit real secrets.

# --- LLM -------------------------------------------------------------------
# mock | azure_openai | anthropic   (mock needs no keys and works offline)
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=azure_openai (Azure OpenAI / Microsoft Foundry).
# Endpoint and key: Foundry portal > your resource > Keys and Endpoint.
# Deployment: the name YOU gave the model deployment, not the model name.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional. Leave unset for reasoning models (gpt-5, o-series), which reject it.
# For older chat models (e.g. gpt-4o), 0 gives the most consistent answers.
# AZURE_OPENAI_TEMPERATURE=0

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<your-anthropic-key>
ANTHROPIC_MODEL=claude-opus-5-5

# --- Blob Storage ----------------------------------------------------------
# "UseDevelopmentStorage=true" points at Azurite, the local emulator.
# For Azure: Storage account > Security + networking > Access keys > Connection string.
# Containers (created automatically): incoming, passports, driving-licences,
# employee-documents, reports
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# --- Database --------------------------------------------------------------
# Leave unset to use a local SQLite file: output/hr_onboarding.db
# For Azure SQL, paste the ODBC string from: SQL database > Connection strings > ODBC
# SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Uid=<user>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# --- Output / logging ------------------------------------------------------
OUTPUT_DIR=output
LOG_LEVEL=INFO
